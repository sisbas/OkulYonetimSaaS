# Application
PORT=3000
# REQUIRED and must be explicit (#259 P1B-02). Allowed values:
#   production | prod            → fail-closed production profile (no local fallbacks)
#   development | dev | test | local → explicit local profile (isolated fallbacks allowed)
# If NODE_ENV is unset or unknown the process REFUSES TO BOOT: an unset NODE_ENV is
# never treated as "local", so a container deploy cannot silently pick up the
# predictable local fallback keys.
NODE_ENV=development

# Database (use a non-production database for local migration/seed/verify commands)
# DATABASE_URL is required for runtime and database verification.
DATABASE_URL=postgres://postgres:***@localhost:5432/okul_yonetim_saas_dev

# JWT signing secrets — REQUIRED in production. The application fails closed (refuses to
# boot) if either is missing or shorter than 32 characters. Do NOT use predictable dev
# values in production. Set a distinct, strong, random value for each (>=32 chars).
# Rotation: include a JWT_KEY_ID to correlate issued tokens with a secret version.
# Stateless JWT means a rotated secret invalidates all previously issued tokens at
# expiry (no migration needed). Key rotation is an operational procedure (re-issue
# secrets + restart); no automatic cross-key validation is implemented.
JWT_ACCESS_SECRET=change-me-to-a-strong-32-char-min-secret
JWT_REFRESH_SECRET=change-me-to-another-strong-32-char-secret
JWT_ISSUER=okul-yonetim-saas
JWT_ACCESS_AUDIENCE=okul-yonetim-saas-api
JWT_REFRESH_AUDIENCE=okul-yonetim-saas-refresh
# REQUIRED in production. Written into every token as the `kid` header and
# enforced on verification: a token whose `kid` does not match the active key id
# is rejected (fail-closed). Rotation therefore invalidates old tokens at once
# instead of accepting them silently. See
# docs/security/secret-rotation-and-rollback.md.
JWT_KEY_ID=key-1

# Audit chain HMAC key — REQUIRED in production (>= 32 chars). Every durable
# audit row is chained (prev_hash -> entry_hash) and signed with HMAC-SHA256.
# The application fails closed (refuses to boot) if this is missing or weak in
# production; local/test runs use an isolated non-production fallback.
# Rotation: set AUDIT_HMAC_KEY_ID to the new key version when you rotate.
# Already-written rows keep their own signature_key_id; verification of old
# rows uses the key that matches their signature_key_id. Rotate by adding the
# new key, keeping the old one available for verification, then retiring it:
#   AUDIT_HMAC_KEY_ID=key-2
#   AUDIT_HMAC_PREVIOUS_KEYS={"key-1":"<the retired key, >= 32 chars>"}
# Retired keys are only used to verify rows that carry that signature_key_id;
# an unknown key id fails verification (fail-closed) instead of silently passing.
AUDIT_HMAC_KEY=change-me-to-a-strong-32-char-min-audit-hmac-key
# REQUIRED in production: without a stable key id a rotated key cannot be
# distinguished from the previous one.
AUDIT_HMAC_KEY_ID=key-1
# AUDIT_HMAC_PREVIOUS_KEYS={"key-0":"<retired key, >= 32 chars>"}

# KVKK pseudonymization — REQUIRED in production (>= 32 chars). Raw student,
# session and guardian UUIDs are never written to logs, audit metadata, outbox
# payloads or API responses; deterministic tenant-scoped pseudonyms are used
# instead (src/kvkk/pseudonym.ts). The application fails closed (refuses to
# boot) if this is missing or weak in production; local/test runs use an
# isolated non-production fallback. Rotation: bump KVKK_PSEUDONYM_KEY_VERSION
# together with the key so new references stay distinguishable.
KVKK_PSEUDONYM_KEY=change-me-to-a-strong-32-char-min-kvkk-pseudonym-key
KVKK_PSEUDONYM_KEY_VERSION=p1

# Parent-contact encryption (KVKK encrypted contact storage) — exactly 32 bytes.
# Validated at startup when configured. In production the parent-contact surface
# fails closed on first use if this is missing, so configure it before enabling
# parent notifications. Rotation: point KVKK_CONTACT_KEY_ID at the new key and
# keep the retired key + its id so existing envelopes stay decryptable.
KVKK_CONTACT_KEY=change-me-contact-key-32bytes!!!
KVKK_CONTACT_KEY_ID=contact-p1
# KVKK_CONTACT_PREVIOUS_KEY=change-me-previous-key-32bytes!!
# KVKK_CONTACT_PREVIOUS_KEY_ID=contact-p0

# Optional: tenant used by permission role seed. The seed creates this tenant when absent.
SEED_TENANT_SLUG=system-seed
SEED_TENANT_NAME=System Seed Tenant

# Stratejik hedefler yüzeyi (#482, ADR 0003). Deploy seviyesinde tek anahtar;
# VARSAYILAN KAPALI. Yalnız literal `true` açar. Kapalıyken `/strategic-goals*`
# route'ları hiç kaydedilmez (404) ve `/context` `capabilities` alanı boş döner.
# Geri alma: değeri `false` yapıp yeniden başlatmak (aynı anda capability düşer).
STRATEGIC_GOALS_ENABLED=false

TYPEORM_LOGGING=false
