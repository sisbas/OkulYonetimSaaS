# Application
PORT=3000
NODE_ENV=development

# Database (use a non-production database for local migration/seed/verify commands)
# DATABASE_URL is required for runtime and database verification.
DATABASE_URL=postgres://postgres:***@localhost:5432/okul_yonetim_saas_dev

# JWT signing secrets — REQUIRED in production. The application fails closed (refuses to
# boot) if either is missing or shorter than 32 characters. Do NOT use predictable dev
# values in production. Set a distinct, strong, random value for each (>=32 chars).
# Rotation: include a JWT_KEY_ID and rotate by issuing new tokens with the new key id;
# old tokens remain valid until expiry (stateless JWT, no migration needed).
JWT_ACCESS_SECRET=change-me-to-a-strong-32-char-min-secret
JWT_REFRESH_SECRET=change-me-to-another-strong-32-char-secret
JWT_ISSUER=okul-yonetim-saas
JWT_ACCESS_AUDIENCE=okul-yonetim-saas-api
JWT_REFRESH_AUDIENCE=okul-yonetim-saas-refresh
JWT_KEY_ID=key-1

# Optional: tenant used by permission role seed. The seed creates this tenant when absent.
SEED_TENANT_SLUG=system-seed
SEED_TENANT_NAME=System Seed Tenant

TYPEORM_LOGGING=false
